{
  "name": "fluxlide",
  "version": "1.0.1",
  "description": "Slideshow creation and playback software",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomakura/Fluxlide.git"
  },
  "type": "module",
  "imports": {
    "#lib/components/*": "./src/lib/components/*",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run src && node --test scripts/check-release.test.mjs",
    "tauri": "tauri",
    "ffmpeg:build": "bash scripts/build-ffmpeg.sh",
    "licenses": "node scripts/third-party-notices.mjs",
    "tauri:release": "npm run licenses && tauri build --config src-tauri/tauri.bundle.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
